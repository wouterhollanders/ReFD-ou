<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension
      id="nl.ou.refd.markers.dangerMarker"
      name = "Refactoring Danger"
      point="org.eclipse.core.resources.markers">
      <super type="org.eclipse.core.resources.problemmarker"/>
      <persistent value="true" />
   </extension>
   
   <extension
         point="org.eclipse.ui.commands">
      <command
            defaultHandler="nl.ou.refd.plugin.ui.topbarmenu.PullUpMethodButton"
            id="refd.PullUpMethodButton"
            name="PullUpMethodButton">
      </command>
   </extension>
   
   <extension
         point="org.eclipse.ui.commands">
      <command
            defaultHandler="nl.ou.refd.plugin.ui.topbarmenu.CombineMethodsIntoClassButton"
            id="refd.CombineMethodsIntoClassButton"
            name="CombineMethodsIntoClassButton">
      </command>
   </extension>
   <extension
		point="org.eclipse.ui.commands">
		<command
			defaultHandler="nl.ou.refd.plugin.ui.topbarmenu.ExtractMethodButton"
			id="refd.ExtractMethodButton"
			name="ExtractMethodButton">
		</command>
	</extension>
	<extension
		point="org.eclipse.ui.commands">
		<command
			defaultHandler="nl.ou.refd.plugin.ui.topbarmenu.ExtractMethodButtonPost"
			id="refd.ExtractMethodButtonPost"
			name="ExtractMethodButtonPost">
		</command>
	</extension>
	<extension
		point="org.eclipse.ui.commands">
		<command
			defaultHandler="nl.ou.refd.plugin.ui.topbarmenu.ResetAnalysisButton"
			id="refd.ResetAnalysisButton"
			name="ResetAnalysisButton">
		</command>
	</extension>
	<extension
		point="org.eclipse.ui.commands">
		<command
			defaultHandler="nl.ou.refd.plugin.ui.topbarmenu.ControlFlowCheckButton"
			id="refd.ControlFlowCheckButton"
			name="ControlFlowCheckButton">
		</command>
	</extension>
   <extension
         point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="menu:org.eclipse.ui.main.menu">
         <menu
               id="RGW"
               label="ReFD">
            <command
                  commandId="refd.PullUpMethodButton"
                  label="Pull Up Method"
                  style="push"
                  tooltip="Pull up a method to one of its superclasses">
            </command>
            <command
                  commandId="refd.CombineMethodsIntoClassButton"
                  label="Combine Methods into Class"
                  style="push"
                  tooltip="Combine a number of methods into a newly created class">
            </command>
            <command
					commandId="refd.ExtractMethodButton"
					label="Extract Method [PRE]"
					style="push"
					tooltip="Extract body to a new method">
				</command>
				<command
					commandId="refd.ExtractMethodButtonPost"
					label="Extract Method [POST]"
					style="push"
					tooltip="Extract body to a new method">
				</command>
				<separator
					name="separator-4"
					visible="true">
				</separator>
				<command
					commandId="refd.ResetAnalysisButton"
					label="Reset Analysis Results"
					style="push"
					tooltip="Resets the results of previous analysis">
				</command>
				<command
					commandId="refd.ControlFlowCheckButton"
					label="Control Flow Checker"
					style="push"
					tooltip="Check Control Flow State">
				</command>
            
         </menu>
      </menuContribution>
   </extension>
   
   
</plugin>
